# Backend environment variables
# Run `npm run setup` to create .env from this file with random secrets filled in.
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWT). Any long random string.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# 64 hex chars (32 bytes). Encrypts the per-file AES keys stored in data/keys.json.
MASTER_KEY=

# Local Hardhat chain started with `npx hardhat node`
RPC_URL=http://127.0.0.1:8545

# IPFS_MODE: auto (use Kubo if running, else local mock store) | kubo | mock
IPFS_MODE=auto
IPFS_API_URL=http://127.0.0.1:5001
