# Git ignore rules
node_modules/
.env

# Hardhat build output
blockchain/artifacts/*
!blockchain/artifacts/.gitkeep
blockchain/cache/
blockchain/typechain-types/

# Generated by deploy / runtime data
backend/config/contract.json
frontend/src/contract.json
backend/data/
backend/uploads/*
!backend/uploads/.gitkeep

# Frontend build output
frontend/dist/
